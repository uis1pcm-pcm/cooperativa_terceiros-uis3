# Cloudflare R2 Storage Configuration
# Local Development Environment Variables

# R2 API Credentials (for S3 API and presigned URLs)
# Generate API tokens in Cloudflare Dashboard: Account → R2 → API Tokens
R2_ACCESS_KEY_ID=your_local_access_key_id_here
R2_SECRET_ACCESS_KEY=your_local_secret_access_key_here

# Cloudflare Account ID
# Find in Cloudflare Dashboard: Account Details → Account ID
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# R2 Bucket Name
R2_BUCKET_NAME=inspecoes-lar

# Public domain for serving images
# For local development: localhost:PORT (where PORT is your app, usually 3000)
# For production: your custom domain (e.g., images.example.com)
PUBLIC_DOMAIN=localhost:3000

# Presigned URL expiration time in seconds
# Valid range: 1 - 604,800 seconds (7 days)
# Default: 3600 (1 hour)
PRESIGNED_URL_EXPIRY=3600
